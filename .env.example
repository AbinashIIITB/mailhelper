# Postgres (matches docker-compose.yml; host port 55432 to avoid other local Postgres instances)
# Production: a managed Postgres, e.g. Neon —
#   postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/mailhelper?sslmode=require
DATABASE_URL="postgresql://dev:dev@localhost:55432/mailhelper?schema=public"

# Redis (matches docker-compose.yml; host port 6380 to avoid native Redis on 6379)
# Production: a managed Redis, e.g. Upstash — note the TLS `rediss://` scheme.
REDIS_URL="redis://localhost:6380"

# AES-256-GCM key for encrypting Gmail app passwords at rest.
# Generate with: openssl rand -hex 32
# The web app and the worker MUST share the same key or saved Gmail passwords
# cannot be decrypted.
ENCRYPTION_KEY="<64 hex chars>"

# next-auth session secret (web app only). Generate with: openssl rand -base64 32
AUTH_SECRET="<random base64>"

# Per-user daily send cap (worker only; Gmail free tier ~500, Workspace ~2000)
DAILY_SEND_LIMIT=450

# --- Deployment only (leave unset locally) -----------------------------------

# Web app. Public health URL of the deployed worker. After enqueuing a campaign
# the web app pings this so a sleeping free-tier worker wakes and starts sending
# instead of waiting for the next request to arrive by chance.
# WORKER_WAKE_URL="https://mailhelper-worker.onrender.com/healthz"

# Worker. Its own public URL, used to stay awake through a long campaign.
# Render injects RENDER_EXTERNAL_URL automatically — set this only on other hosts.
# WORKER_PUBLIC_URL="https://mailhelper-worker.onrender.com"

# Worker. Seconds to block on an idle queue (default 30). Higher means fewer
# Redis commands, which matters against Upstash's free monthly command quota.
# WORKER_DRAIN_DELAY=30
