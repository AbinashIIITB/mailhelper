generator client {
  provider = "prisma-client-js"
  // "native" covers local dev and Render (Debian); Vercel's build+runtime image
  // is Amazon Linux 2023, which needs the rhel-openssl-3.0.x engine.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Pooled connection (Supabase Supavisor / Neon pooler). Every serverless cold
  // start opens its own connection, so the app must never use a direct one.
  url       = env("DATABASE_URL")
  // Schema changes can't run through a transaction-mode pooler. Only `prisma
  // db push` / `migrate` read this, so it's needed locally but not in the
  // deployed web or worker environments.
  directUrl = env("DIRECT_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  createdAt    DateTime    @default(now())

  smtpConfig   SmtpConfig?
  campaigns    Campaign[]
}

model SmtpConfig {
  id             String   @id @default(cuid())
  userId         String   @unique
  gmailAddress   String
  appPasswordEnc String // AES-256-GCM encrypted
  fromName       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum CampaignStatus {
  draft
  queued
  sending
  completed
  failed
}

model Campaign {
  id           String         @id @default(cuid())
  userId       String
  name         String
  subject      String         @default("")
  bodyTemplate String         @default("")
  status       CampaignStatus @default(draft)
  total        Int            @default(0)
  sent         Int            @default(0)
  failed       Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipients   Recipient[]

  @@index([userId])
}

enum RecipientStatus {
  pending
  sent
  failed
}

model Recipient {
  id         String          @id @default(cuid())
  campaignId String
  email      String
  variables  Json            @default("{}")
  status     RecipientStatus @default(pending)
  error      String?
  sentAt     DateTime?
  createdAt  DateTime        @default(now())

  campaign   Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
}
