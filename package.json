{
  "name": "mailhelper",
  "private": true,
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "db:generate": "npm run db:generate -w @mailhelper/db",
    "db:push": "npm run db:push -w @mailhelper/db",
    "db:lockdown": "npm run db:lockdown -w @mailhelper/db"
  },
  "devDependencies": {
    "turbo": "^2.10.0"
  }
}
